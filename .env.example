# Required for cloud auth (Supabase Auth). Without these, local browser auth is used.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public HTTPS origin of the deployed Next.js app (used by Capacitor iOS shell).
NEXT_PUBLIC_APP_URL=https://bodhi-path.vercel.app

# Capacitor sync/open: URL the WKWebView loads (defaults to NEXT_PUBLIC_APP_URL / bodhi-path.vercel.app).
# CAPACITOR_SERVER_URL=https://bodhi-path.vercel.app
